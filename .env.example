# ── 前端 ──
NEXT_PUBLIC_API_URL=http://127.0.0.1:8810
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 後端（只在伺服器端，不可放進前端或提交到 Git）──
APP_ENV=development
DEMO_MODE=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://leverage:leverage_local_dev@127.0.0.1:54330/leverage

# local：本機示範帳號；supabase：驗證 Supabase Auth JWT
AUTH_MODE=local
JWT_SECRET=change-me-to-a-long-random-string
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# AI：ollama（千問，本機）、gemini、none
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
GOOGLE_API_KEY=
GEMINI_MODEL=

REDIS_URL=
MAX_UPLOAD_SIZE=10485760
MAX_AGENT_ITERATIONS=8
MAX_ANALYSIS_COST=0.5
LEGAL_SOURCE_SYNC_ENABLED=false
REGULATORY_MONITOR_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
