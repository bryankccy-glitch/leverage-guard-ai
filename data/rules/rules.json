{
  "schema_version": "rule-schema-1.0",
  "notes": "每條規則的 sources[].quote 必須逐字出現在 data/legal/documents.json 的對應條文（忽略空白）。載入時自動驗證；驗證失敗的規則不能執行。review_status 一律從 pending_review 開始，需由 Legal Reviewer 在後台核准才會變成 active。",
  "rules": [
    {
      "rule_id": "MARGIN-RATIO-FORMULA", "version": "1.0.0", "rule_type": "calculation_method",
      "rule_name": "擔保維持率計算方式", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [
        {"source_key": "twse:FL007121", "article_number": "第53條", "quote": "證券商應逐日依下列公式計算每一信用帳戶之整戶及各筆融資融券擔保維持率"},
        {"source_key": "moj:G0400024", "article_number": "第17條", "quote": "應逐日計算每一信用帳戶內之擔保品價值與客戶債務之比率"}
      ],
      "parameters": {}, "condition": null, "event": null, "required_facts": [], "exceptions": [],
      "plain_language": "券商每天都會算你信用帳戶的擔保維持率：擔保品市值除以借款。單一融資部位、沒有融券時，就是「股票市值 ÷ 融資金額」。",
      "is_demo": false
    },
    {
      "rule_id": "MARGIN-CALL-THRESHOLD", "version": "1.0.0", "rule_type": "maintenance_threshold",
      "rule_name": "整戶擔保維持率追繳門檻", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第54條", "quote": "委託人信用帳戶之整戶擔保維持率低於百分之一百三十者，證券商應即通知委託人"}],
      "parameters": {"threshold": "1.30"},
      "condition": {"op": "lt", "field": "maintenance_ratio", "parameter": "threshold"},
      "event": "maintenance_threshold_breach", "required_facts": ["maintenance_ratio"], "exceptions": [],
      "plain_language": "整戶擔保維持率跌破 130% 時，券商應通知你補繳差額。",
      "investor_obligations": ["在期限內補繳差額，或以規定的有價證券抵繳"],
      "investor_rights": ["收到通知後在期限內補繳，可避免擔保品被處分"],
      "broker_obligations": ["逐日計算維持率，低於門檻時應即通知委託人"],
      "broker_rights": [], "required_evidence": ["券商的追繳通知（含送達時間）", "當日對帳單或維持率紀錄"],
      "is_demo": false
    },
    {
      "rule_id": "MARGIN-CALL-DEADLINE", "version": "1.0.0", "rule_type": "deadline",
      "rule_name": "補繳期限", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第54條", "quote": "於通知送達之日起二個營業日內補繳融資自備款或融券保證金差額"}],
      "parameters": {"business_days": "2", "counted_from": "notice_served_date"},
      "condition": {"op": "exists", "field": "notice_served_date"},
      "event": "top_up_deadline", "required_facts": ["notice_served_date"], "exceptions": [],
      "plain_language": "補繳期限從「通知送達之日」起算二個營業日。沒有確切的送達日期，就無法算出正確期限。",
      "investor_obligations": ["於期限內補繳差額"], "investor_rights": ["期限內補足可避免處分"],
      "broker_obligations": [], "broker_rights": [], "required_evidence": ["通知送達日期與方式的紀錄"],
      "is_demo": false
    },
    {
      "rule_id": "MARGIN-CALL-AMOUNT", "version": "1.0.0", "rule_type": "calculation_method",
      "rule_name": "融資自備款差額計算", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第54條", "quote": "委託人依前項規定應行補繳之差額，依下列公式計算"}],
      "parameters": {}, "condition": null, "event": null, "required_facts": [], "exceptions": [],
      "plain_language": "應補繳的差額＝融資金額 −（計算日收盤價 × 融資股數 × 融資比率）−（抵繳品價值 × 融資比率）。",
      "is_demo": false
    },
    {
      "rule_id": "MARGIN-CALL-CANCEL", "version": "1.0.0", "rule_type": "event_condition",
      "rule_name": "取消追繳紀錄", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第55條", "quote": "委託人整戶擔保維持率回升至百分之一百六十六以上者，取消其追繳紀錄"},
                  {"source_key": "twse:FL007121", "article_number": "第55條", "quote": "陸續繳納差額，合計達到所通知之補繳差額者，取消其追繳紀錄"}],
      "parameters": {"cancel_threshold": "1.66"},
      "condition": {"any": [{"op": "gte", "field": "maintenance_ratio", "parameter": "cancel_threshold"},
                            {"op": "gte", "field": "topped_up_amount", "field_ref": "margin_call_amount"}]},
      "event": "margin_call_cleared", "required_facts": ["maintenance_ratio"], "exceptions": [],
      "plain_language": "維持率回到 166% 以上，或陸續補繳達到通知的差額，追繳紀錄就會取消。",
      "investor_rights": ["補足差額或維持率回升後，追繳紀錄取消"], "investor_obligations": [],
      "broker_obligations": [], "broker_rights": [], "required_evidence": ["補繳款項入帳紀錄"],
      "is_demo": false
    },
    {
      "rule_id": "MARGIN-DISPOSAL-CONDITION", "version": "1.0.0", "rule_type": "event_condition",
      "rule_name": "未補繳且維持率仍不足時處分擔保品", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第55條", "quote": "當日委託人整戶擔保維持率仍不足者，自次一營業日起準用第八十一條第三項規定處分其擔保品"},
                  {"source_key": "moj:G0400024", "article_number": "第18條", "quote": "證券商客戶未能依前條第一項規定補繳差額，或逾約定期限未能清結時，證券商應即處分其擔保品"}],
      "parameters": {"threshold": "1.30"},
      "condition": {"all": [{"op": "eq", "field": "deadline_passed", "value": true},
                            {"op": "eq", "field": "margin_call_cleared", "value": false},
                            {"op": "lt", "field": "maintenance_ratio", "parameter": "threshold"}]},
      "event": "collateral_disposal_condition", "required_facts": ["deadline_passed", "maintenance_ratio"],
      "exceptions": ["雙方另有約定者，依約定（第 55 條、管理辦法第 18 條但書）"],
      "plain_language": "期限內沒補足，且期限當天維持率仍低於 130%，券商自次一營業日起會處分你的擔保品（俗稱斷頭）。",
      "investor_obligations": ["承擔處分後仍不足清償的債務"], "investor_rights": ["處分後如有溢額，應發還給你"],
      "broker_obligations": ["依規定方式處分擔保品"], "broker_rights": ["處分擔保品以清償債務"],
      "required_evidence": ["處分成交明細", "處分通知"], "is_demo": false
    },
    {
      "rule_id": "MARGIN-DISPOSAL-DEFERRED", "version": "1.0.0", "rule_type": "event_condition",
      "rule_name": "期限當日維持率回升至門檻以上得暫不處分", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第55條", "quote": "當日委託人整戶擔保維持率回升至百分之一百三十以上，得暫不處分其擔保品"}],
      "parameters": {"threshold": "1.30"},
      "condition": {"all": [{"op": "eq", "field": "deadline_passed", "value": true},
                            {"op": "eq", "field": "margin_call_cleared", "value": false},
                            {"op": "gte", "field": "maintenance_ratio", "parameter": "threshold"}]},
      "event": "disposal_deferred", "required_facts": ["deadline_passed", "maintenance_ratio"], "exceptions": [],
      "plain_language": "期限當天維持率回到 130% 以上，券商「得」暫不處分；但之後任一營業日又不足且當天下午沒自動補繳，次一營業日起仍會處分。追繳紀錄並沒有取消。",
      "investor_obligations": ["持續注意維持率，再度不足時須當日補繳"], "investor_rights": [],
      "broker_obligations": [], "broker_rights": ["維持率再度不足時，自次一營業日起處分"],
      "required_evidence": ["每日維持率紀錄"], "is_demo": false
    },
    {
      "rule_id": "MARGIN-DISPOSAL-SURPLUS", "version": "1.0.0", "rule_type": "event_condition",
      "rule_name": "處分後溢額發還", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第55條", "quote": "經處分後如有溢額應予發還"}],
      "parameters": {}, "condition": {"op": "gt", "field": "surplus_returned", "value": "0"},
      "event": "surplus_returned", "required_facts": ["surplus_returned"], "exceptions": [],
      "plain_language": "擔保品賣掉後，清償債務還有剩，剩下的錢要還給你。",
      "investor_rights": ["取回處分後的溢額"], "investor_obligations": [], "broker_obligations": ["發還溢額"],
      "broker_rights": [], "required_evidence": ["處分結算明細"], "is_demo": false
    },
    {
      "rule_id": "MARGIN-DISPOSAL-SHORTFALL", "version": "1.0.0", "rule_type": "event_condition",
      "rule_name": "處分後不足抵償：抵充並通知補足", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第55條", "quote": "即以其信用帳戶內之其他款項抵充，經抵充仍有不足者，證券商應通知委託人於次一營業日補足差額"}],
      "parameters": {}, "condition": {"op": "gt", "field": "remaining_debt", "value": "0"},
      "event": "remaining_debt_notice", "required_facts": ["remaining_debt"], "exceptions": [],
      "plain_language": "擔保品賣掉後還不夠還借款，券商會先用你信用帳戶裡其他款項抵充，還不夠就通知你次一營業日補足。本金虧完不代表債務結束。",
      "investor_obligations": ["於次一營業日補足剩餘差額"], "investor_rights": ["取得處分結算明細"],
      "broker_obligations": ["通知委託人補足"], "broker_rights": ["以帳戶內其他款項抵充"],
      "required_evidence": ["處分結算明細", "補足通知"], "is_demo": false
    },
    {
      "rule_id": "MARGIN-LIQUIDITY-FAILURE", "version": "1.0.0", "rule_type": "event_condition",
      "rule_name": "連續六個營業日無法全數成交", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第55條", "quote": "連續六個營業日開市前以當市開盤競價基準或開始交易基準價加減百分之十委託買賣"}],
      "parameters": {"days": "6"}, "condition": {"op": "gte", "field": "unfilled_disposal_days", "parameter": "days"},
      "event": "disposal_unfilled", "required_facts": ["unfilled_disposal_days"], "exceptions": [],
      "plain_language": "市場流動性不足時，券商連續六個營業日委託處分仍無法全數成交，會改以帳戶其他款項抵充並通知你補足。",
      "investor_obligations": ["補足差額"], "investor_rights": [], "broker_obligations": ["通知委託人補足"],
      "broker_rights": ["以帳戶內其他款項抵充"], "required_evidence": ["每日委託處分紀錄"], "is_demo": false
    },
    {
      "rule_id": "MARGIN-DEFAULT-REPORT", "version": "1.0.0", "rule_type": "event_condition",
      "rule_name": "限期清償逾期：申報違約", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第81條", "quote": "則通知委託人限期清償，逾期未清償者，證券商應向證券交易所或櫃檯買賣中心申報違約，並註銷其信用帳戶"}],
      "parameters": {}, "condition": {"all": [{"op": "eq", "field": "shortfall_unpaid_after_deadline", "value": true}]},
      "event": "default_report", "required_facts": ["shortfall_unpaid_after_deadline"],
      "exceptions": ["雙方另有約定者，依約定（第 81 條但書）"],
      "plain_language": "補足通知後仍未清償，券商會通知限期清償；逾期仍未清償，券商應申報違約並註銷信用帳戶。是否真的申報，以券商實際作業為準。",
      "investor_obligations": ["於限期內清償債務"], "investor_rights": ["對處分與結算有疑義時，可依金融消費爭議程序申訴"],
      "broker_obligations": ["逾期未清償時向證交所或櫃買中心申報違約"], "broker_rights": ["註銷信用帳戶"],
      "required_evidence": ["限期清償通知", "結算明細"], "is_demo": false
    },
    {
      "rule_id": "MARGIN-PENALTY", "version": "1.0.0", "rule_type": "calculation_method",
      "rule_name": "融資違約金", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL007121", "article_number": "第82條", "quote": "按應補差額乘以融資利率百分之十收取融資違約金"}],
      "parameters": {"penalty_rate_of_financing_rate": "0.10"}, "condition": null, "event": null,
      "required_facts": [], "exceptions": [],
      "plain_language": "違約後，券商「得」自違約日起至清償日止，按應補差額乘以融資利率的 10% 收取違約金。",
      "is_demo": false
    },
    {
      "rule_id": "MARGIN-NO-WITHDRAW-GAINS", "version": "1.0.0", "rule_type": "obligation",
      "rule_name": "帳面增值不得領出", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "moj:G0400024", "article_number": "第20條", "quote": "不得對客戶交付相當於該增加金額之金錢或有價證券或商品"}],
      "parameters": {}, "condition": null, "event": null, "required_facts": [], "exceptions": [],
      "plain_language": "股價上漲讓帳戶淨值增加，券商不能把增加的部分交給你，也不能拿來抵自備款。",
      "is_demo": false
    },
    {
      "rule_id": "MARGIN-CONTRACT-REQUIRED", "version": "1.0.0", "rule_type": "obligation",
      "rule_name": "融資融券契約與信用帳戶", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "margin",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "moj:G0400024", "article_number": "第10條", "quote": "應與客戶簽訂融資融券契約，並開立信用帳戶"}],
      "parameters": {}, "condition": null, "event": "position_opened", "required_facts": [], "exceptions": [],
      "plain_language": "融資交易要先和券商簽融資融券契約、開立信用帳戶；追繳比率、期限、處分方式都必須寫在契約裡。",
      "investor_rights": ["取得並了解契約中載明的比率、補繳期限與處分方式"],
      "investor_obligations": ["遵守契約約定"], "broker_obligations": ["於契約載明比率、補繳期限與處分方式"],
      "broker_rights": [], "required_evidence": ["融資融券契約"], "is_demo": false
    },
    {
      "rule_id": "TAX-GENERAL", "version": "1.0.0", "rule_type": "tax_rate",
      "rule_name": "股票證券交易稅（一般）", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "general",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "moj:G0340078", "article_number": "第2條", "quote": "公司發行之股票及表明股票權利之證書或憑證徵千分之三"}],
      "parameters": {"rate": "0.003"}, "condition": null, "event": null, "required_facts": [], "exceptions": [],
      "plain_language": "賣出股票時，由賣方按成交價格繳千分之三的證券交易稅。",
      "is_demo": false
    },
    {
      "rule_id": "TAX-DAYTRADE", "version": "1.0.0", "rule_type": "tax_rate",
      "rule_name": "現股當沖證券交易稅（千分之一點五）", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "day_trading",
      "effective_from": "2017-04-28", "effective_to": "2027-12-31",
      "sources": [{"source_key": "moj:G0340078", "article_number": "第2-2條", "quote": "同一帳戶於同一營業日現款買進與現券賣出同種類同數量之上市或上櫃股票，於出賣時，按每次交易成交價格依千分之一點五稅率課徵證券交易稅"}],
      "parameters": {"rate": "0.0015"}, "condition": null, "event": null, "required_facts": ["trade_date"],
      "exceptions": ["證券商自行買賣適用期間自 2018-04-28 起"],
      "plain_language": "同一天、同一帳戶、同種類同數量的現股當沖，賣出時稅率是千分之一點五；期間到民國 116 年（2027 年）12 月 31 日，之後若未延長就回到千分之三。",
      "is_demo": false
    },
    {
      "rule_id": "DT-DEFINITION", "version": "1.0.0", "rule_type": "definition",
      "rule_name": "當日沖銷交易定義與差價交割", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "day_trading",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL071871", "article_number": "第1條", "quote": "就相同數量部分相抵之普通交割買賣，按買賣沖銷後差價辦理款項交割"}],
      "parameters": {}, "condition": null, "event": "trade_executed", "required_facts": [], "exceptions": [],
      "plain_language": "當沖是同一天買進、賣出同一檔，相同數量的部分互相抵銷，只交割差價。",
      "investor_rights": ["相同數量部分只需交割差價"], "investor_obligations": ["負擔差價損失與手續費、稅"],
      "broker_obligations": [], "broker_rights": [], "required_evidence": ["成交回報與對帳單"], "is_demo": false
    },
    {
      "rule_id": "DT-ELIGIBILITY", "version": "1.0.0", "rule_type": "eligibility",
      "rule_name": "當沖資格與風險預告書", "jurisdiction": "TW", "market": "TWSE/TPEx", "trading_type": "day_trading",
      "effective_from": null, "effective_to": null,
      "sources": [{"source_key": "twse:FL071871", "article_number": "第2條", "quote": "應開立受託買賣帳戶滿三個月且最近一年內委託買賣成交達十筆（含）以上"}],
